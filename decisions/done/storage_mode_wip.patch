 # The storage rule a policy is evaluated under. "matched" training uses it too.
 EVALUATION_STORAGE_MODE = "fixed"
+
+
+class StorageSettings(NamedTuple):
+    """The storage rule of a run and its parameters (tab:storageparams). The thesis leaves the
+    epoch length Delta, the relocation cap nu and the congestion weight beta TBD, so there is no
+    default for them. An adaptive rule needs the ones it reads, and F_fix takes none."""
+
+    mode: str = "fixed"
+    epoch: int | None = None  # Delta, steps between storage updates
+    cap: int | None = None  # nu, units relocated per update at most
+    weight: float | None = None  # beta, F_cng only
+
+
+FIXED_STORAGE = StorageSettings()
+
+
+def add_storage_arguments(parser: argparse.ArgumentParser) -> None:
+    """The storage flags shared by 04, 04b and 05. Without them every run uses F_fix."""
+    parser.add_argument(
+        "--storage-mode",
+        choices=["fixed", "demand", "congestion"],
+        default="fixed",
+        help="storage rule the policy is evaluated under, and trained under with "
+        "--regime matched (default fixed)",
+    )
+    parser.add_argument("--storage-epoch", type=int, help="Delta, steps between storage updates")
+    parser.add_argument("--reassignment-cap", type=int, help="nu, units relocated per update")
+    parser.add_argument("--congestion-weight", type=float, help="beta, congestion rule only")
+
+
+def storage_from_args(args: argparse.Namespace, parser: argparse.ArgumentParser) -> StorageSettings:
+    """The StorageSettings of the flags, or a parser error for a combination the model rules out."""
+    settings = StorageSettings(
+        args.storage_mode, args.storage_epoch, args.reassignment_cap, args.congestion_weight
+    )
+    problem = storage_problem(settings)
+    if problem:
+        parser.error(problem)
+    return settings
+
+
+def storage_problem(settings: StorageSettings) -> str | None:
+    """Why `settings` is not a storage rule of the thesis, or None."""
+    if settings.mode == "fixed":
+        if any(v is not None for v in (settings.epoch, settings.cap, settings.weight)):
+            return "--storage-mode fixed takes no --storage-epoch, --reassignment-cap or beta"
+        return None
+    missing = [
+        flag
+        for flag, value in (
+            ("--storage-epoch", settings.epoch),
+            ("--reassignment-cap", settings.cap),
+        )
+        if value is None
+    ]
+    if settings.mode == "congestion" and settings.weight is None:
+        missing.append("--congestion-weight")
+    if settings.mode == "demand" and settings.weight is not None:
+        return "--congestion-weight only applies to --storage-mode congestion"
+    if missing:
+        return f"--storage-mode {settings.mode} needs " + ", ".join(missing)
+    if settings.epoch is not None and settings.epoch < 1:
+        return "--storage-epoch must be positive"
+    if settings.cap is not None and settings.cap < 0:
+        return "--reassignment-cap must not be negative"
+    return None
+
+
